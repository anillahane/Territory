# Development Dockerfile for Frontend
FROM node:22-bookworm-slim

WORKDIR /app

ENV NPM_CONFIG_STRICT_SSL=false \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --no-audit --fund=false

# Copy the dependency refresh helper first so stale dev volumes can self-heal.
COPY docker-dev-entrypoint.sh ./docker-dev-entrypoint.sh

# Copy source code
COPY . .

RUN chmod +x docker-dev-entrypoint.sh

# Expose port
EXPOSE 5173

ENTRYPOINT ["sh", "./docker-dev-entrypoint.sh"]

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
