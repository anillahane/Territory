# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=location_pockets
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Batch Processing - Hybrid Worker Configuration
# Files with fewer rows use Node.js worker (fast, in-memory)
# Files with more rows use Python worker (memory-efficient, faster for large files)
PYTHON_WORKER_THRESHOLD=5000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Job Queue
QUEUE_CONCURRENCY=5

# Grid Tile Cache Warming
# true/false: automatically warm tiles on backend startup
GRID_WARM_ENABLED=true
# Comma-separated levels in km
GRID_WARM_LEVELS=10,5,1
# Global zooms (used when per-level zooms are not provided)
# GRID_WARM_ZOOMS=8
# Optional per-level zoom sets
GRID_WARM_ZOOMS_10=5,6
GRID_WARM_ZOOMS_5=6,7
GRID_WARM_ZOOMS_1=8
# Optional semicolon-separated bbox list: minLon,minLat,maxLon,maxLat
GRID_WARM_BOUNDS=68,6.5,97.5,37.5
# Safety limits
GRID_WARM_MAX_TILES=2000
GRID_WARM_CONCURRENCY=4
