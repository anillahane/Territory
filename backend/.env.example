# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=location_pockets
DB_USER=postgres
DB_PASSWORD=replace_with_strong_db_password
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=15000
DB_HEALTH_RETRY_ATTEMPTS=5
DB_HEALTH_RETRY_DELAY_MS=5000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=admin

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Batch Processing - Hybrid Worker Configuration
# Files with fewer rows use Node.js worker (fast, in-memory)
# Files with more rows use Python worker (memory-efficient, faster for large files)
PYTHON_WORKER_THRESHOLD=5000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Job Queue
QUEUE_CONCURRENCY=5
